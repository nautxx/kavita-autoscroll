KAVITA_CONFIG_PATH=/path/to/kavita/config
KAVITA_LIBRARY_PATH=/path/to/kavita/library
KAVITA_PORT=5005
AUTOSCROLL_VERSION=0.5.1
PUID=1000
PGID=1000
TZ=Etc/UTC

# KeyboardEvent.key values used by the injected browser script.
AUTOSCROLL_TOGGLE_SHORTCUT=s
AUTOSCROLL_SLOWER_SHORTCUT=[
AUTOSCROLL_FASTER_SHORTCUT=]
