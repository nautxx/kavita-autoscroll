{
  "manifest_version": 3,
  "name": "Scrollito: auto-scroll for Kavita",
  "version": "1.3.1",
  "description": "Adjustable auto-scrolling for the Kavita webtoon reader.",
  "homepage_url": "https://github.com/nautxx/scrollito",
  "content_scripts": [
    {
      "matches": [
        "*://*/*/manga/*"
      ],
      "js": [
        "scrollito.user.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
