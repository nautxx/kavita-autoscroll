{
  "manifest_version": 3,
  "name": "Kavita Webtoon Auto-scroll",
  "version": "0.3.0",
  "description": "Adjustable auto-scrolling for the Kavita webtoon reader.",
  "homepage_url": "https://github.com/nautxx/kavita-autoscroll",
  "content_scripts": [
    {
      "matches": [
        "*://*/*/manga/*"
      ],
      "js": [
        "kavita-autoscroll.user.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
